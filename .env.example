NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# ── Supabase keys: two generations, both currently read ────────────────────
#
# Supabase renamed these. anon/service_role are the legacy JWT pair;
# publishable/secret are the current names. The code reads all four because the
# project is mid-migration, so a missing *new* key falls back to the legacy one
# rather than failing at runtime.
#
# Collapsing to one pair is a deliberate one-way door and is NOT part of routine
# env tidy-up: dropping the legacy pair invalidates anything still holding it.
# Do it as its own change, with the rotation order written down first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Direct Postgres connection, for migrations and the RLS verification scripts
# only. Never read by the app at runtime.
SUPABASE_DB_URL=postgresql://...

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id

# Origins allowed to call /api/v1 from a browser on another origin.
# Comma-separated, exact match, and never "*". Unset means no cross-origin
# access at all, which is the correct default — the web app and the demo are
# same-origin and need nothing here. Set it for Expo Web during development,
# e.g. http://localhost:8081. See lib/cors.ts.
CORS_ALLOWED_ORIGINS=

# Shared secret for /api/health/consultant, the round-trip gate.
#
# That route asks the live consultant a real question, so it spends Gemini
# tokens on every call. It is closed rather than the prompt made cheap — see
# CREWCHIEF_ROUNDTRIP_GATE_DESIGN.md. Unset means nobody can call it, which is
# the safe direction for an endpoint that costs money.
#
# Any long random string. Set the same value in Netlify for the deployments
# the promote gate and the canary check.
CONSULTANT_HEALTH_SECRET=

# Base URL the consultant canary probes, e.g. https://crewchief-demo.netlify.app
# Used only by scripts/consultant-canary.mjs, never by the app. Also needs to
# exist as a GitHub Actions secret for the scheduled canary workflow.
CREWCHIEF_CI_URL=
