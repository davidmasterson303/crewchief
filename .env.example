NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# ── Supabase keys: two generations, both currently read ────────────────────
#
# Supabase renamed these. anon/service_role are the legacy JWT pair;
# publishable/secret are the current names. The code reads all four because the
# project is mid-migration, so a missing *new* key falls back to the legacy one
# rather than failing at runtime.
#
# Collapsing to one pair is a deliberate one-way door and is NOT part of routine
# env tidy-up: dropping the legacy pair invalidates anything still holding it.
# Do it as its own change, with the rotation order written down first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Direct Postgres connection, for migrations and the RLS verification scripts
# only. Never read by the app at runtime.
SUPABASE_DB_URL=postgresql://...

GEMINI_API_KEY=your_gemini_api_key

# Absolute origin this deployment answers on, used as `metadataBase` in
# app/layout.tsx — which is what makes og:image an absolute URL rather than a
# localhost one. Leave it unset for production: the fallback is the real
# domain, so an unset variable degrades to "correct for prod" rather than back
# to localhost. Set it on deploy previews so a preview's share card points at
# the preview instead of claiming to be the live site.
NEXT_PUBLIC_SITE_URL=

# Origins allowed to call /api/v1 from a browser on another origin.
# Comma-separated, exact match, and never "*". Unset means no cross-origin
# access at all, which is the correct default — the web app and the demo are
# same-origin and need nothing here. Set it for Expo Web during development,
# e.g. http://localhost:8081. See lib/cors.ts.
CORS_ALLOWED_ORIGINS=

# Shared secret for /api/health/consultant, the round-trip gate.
#
# That route asks the live consultant a real question, so it spends Gemini
# tokens on every call. It is closed rather than the prompt made cheap — see
# CREWCHIEF_ROUNDTRIP_GATE_DESIGN.md. Unset means nobody can call it, which is
# the safe direction for an endpoint that costs money.
#
# Any long random string. Set the same value in Netlify for the deployments
# the promote gate and the canary check.
CONSULTANT_HEALTH_SECRET=

# Base URL the consultant canary probes, e.g. https://crewchief-demo.netlify.app
# Used only by scripts/consultant-canary.mjs, never by the app. Also needs to
# exist as a GitHub Actions secret for the scheduled canary workflow.
CREWCHIEF_CI_URL=

# Shared secret for the nightly notification sweep — Phase 5, C1.
#
# The Netlify scheduled function `netlify/functions/notify-sweep.mts` sends this
# as `x-cron-secret` to `/api/internal/notify-sweep`, which refuses every
# request without it.
#
# **Unset means the sweep refuses to run at all**, and that is deliberate rather
# than a limitation. That endpoint sends a push notification to every account in
# the product, so "unconfigured means open" would turn a deploy that missed this
# variable into an open relay for spamming your own users. A push cannot be
# recalled.
#
# Any long random string. Set the same value in Netlify.
CRON_SECRET=

# ADDITIONAL Apple trust anchors — Phase 6, E8. Almost certainly leave unset.
#
# ⚠ This is not how Apple's root certificate is configured. Apple Root CA - G3
# is **committed** in `lib/apple-root-ca.ts`, deliberately: it is public rather
# than secret, so keeping it out of the repo protects nothing, and as an
# environment variable anyone with dashboard access could repoint what this
# application trusts with no diff and no commit. A forged chain under a swapped
# root verifies perfectly, so that change would be invisible.
#
# This variable can only **add** roots, never replace the committed one. Its
# single purpose is the overlap when G3 expires on 30 April 2039 and a successor
# has to be trusted alongside it before a deploy can drop the old one.
#
# Because it only adds, a typo, a truncated paste or an empty value degrades to
# exactly the security already in place rather than to none.
#
# One or more concatenated PEM blocks.
APPLE_ROOT_CA_PEM=
