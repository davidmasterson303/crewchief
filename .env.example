NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# ── Supabase keys: two generations, both currently read ────────────────────
#
# Supabase renamed these. anon/service_role are the legacy JWT pair;
# publishable/secret are the current names. The code reads all four because the
# project is mid-migration, so a missing *new* key falls back to the legacy one
# rather than failing at runtime.
#
# Collapsing to one pair is a deliberate one-way door and is NOT part of routine
# env tidy-up: dropping the legacy pair invalidates anything still holding it.
# Do it as its own change, with the rotation order written down first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Direct Postgres connection, for migrations and the RLS verification scripts
# only. Never read by the app at runtime.
SUPABASE_DB_URL=postgresql://...

GEMINI_API_KEY=your_gemini_api_key

# Absolute origin this deployment answers on, used as `metadataBase` in
# app/layout.tsx — which is what makes og:image an absolute URL rather than a
# localhost one. Leave it unset for production: the fallback is the real
# domain, so an unset variable degrades to "correct for prod" rather than back
# to localhost. Set it on deploy previews so a preview's share card points at
# the preview instead of claiming to be the live site.
NEXT_PUBLIC_SITE_URL=

# Origins allowed to call /api/v1 from a browser on another origin.
# Comma-separated, exact match, and never "*". Unset means no cross-origin
# access at all, which is the correct default — the web app and the demo are
# same-origin and need nothing here. Set it for Expo Web during development,
# e.g. http://localhost:8081. See lib/cors.ts.
CORS_ALLOWED_ORIGINS=

# Shared secret for /api/health/consultant, the round-trip gate.
#
# That route asks the live consultant a real question, so it spends Gemini
# tokens on every call. It is closed rather than the prompt made cheap — see
# CREWCHIEF_ROUNDTRIP_GATE_DESIGN.md. Unset means nobody can call it, which is
# the safe direction for an endpoint that costs money.
#
# Any long random string. Set the same value in Netlify for the deployments
# the promote gate and the canary check.
CONSULTANT_HEALTH_SECRET=

# Gates /api/health/ai, which reports whether this deployment's Gemini
# credential works.
#
# ⚠ It was PUBLIC until 24 Aug, and that was PERF-05: `force-dynamic` plus
# `no-store` means the CDN never answers one, so every request is a function
# invocation, and the 60s cache is per warm instance — so a burst made N real
# calls to Google with the production key. It was also a credential-validity
# oracle (200 = the key works, 503 = it was rotated).
#
# Falls back to CONSULTANT_HEALTH_SECRET when unset, so an existing deployment
# keeps working. Unset entirely means nobody can run the check — it fails
# closed, like its sibling.
#
# ⚠ Needed in TWO places with matching values, same as the consultant one:
# the Netlify env AND wherever verify-demo.mjs runs. See CLAUDE.md §7.
AI_HEALTH_SECRET=

# Base URL the consultant canary probes, e.g. https://crewchief-demo.netlify.app
# Used only by scripts/consultant-canary.mjs, never by the app. Also needs to
# exist as a GitHub Actions secret for the scheduled canary workflow.
CREWCHIEF_CI_URL=

# Shared secret for the nightly notification sweep — Phase 5, C1.
#
# The Netlify scheduled function `netlify/functions/notify-sweep.mts` sends this
# as `x-cron-secret` to `/api/internal/notify-sweep`, which refuses every
# request without it.
#
# **Unset means the sweep refuses to run at all**, and that is deliberate rather
# than a limitation. That endpoint sends a push notification to every account in
# the product, so "unconfigured means open" would turn a deploy that missed this
# variable into an open relay for spamming your own users. A push cannot be
# recalled.
#
# Any long random string. Set the same value in Netlify.
CRON_SECRET=

# ADDITIONAL Apple trust anchors — Phase 6, E8. Almost certainly leave unset.
#
# ⚠ This is not how Apple's root certificate is configured. Apple Root CA - G3
# is **committed** in `lib/apple-root-ca.ts`, deliberately: it is public rather
# than secret, so keeping it out of the repo protects nothing, and as an
# environment variable anyone with dashboard access could repoint what this
# application trusts with no diff and no commit. A forged chain under a swapped
# root verifies perfectly, so that change would be invisible.
#
# This variable can only **add** roots, never replace the committed one. Its
# single purpose is the overlap when G3 expires on 30 April 2039 and a successor
# has to be trusted alongside it before a deploy can drop the old one.
#
# Because it only adds, a typo, a truncated paste or an empty value degrades to
# exactly the security already in place rather than to none.
#
# One or more concatenated PEM blocks.
APPLE_ROOT_CA_PEM=

# Set to `true` on the DEMO site only — crewchief-demo.davidmasterson.co.
#
# Shows the "DAVID MASTERSON. | PORTFOLIO DEMO" masthead. One codebase deploys
# two sites, and until 20 Aug nothing in the app knew which it was: the banner
# rendered unconditionally, so the App Store listing's privacy-policy URL
# carried a masthead calling the service a demo.
#
# ⚠ **Unset means the product site, and that direction is deliberate.** The
# variable enables the demo framing rather than disabling it, so a deploy that
# missed it degrades toward the portfolio piece losing its byline — which David
# would notice within a day — never toward Apple reading a privacy policy under
# a "PORTFOLIO DEMO" heading, which is invisible to us until a reviewer finds it.
#
# Only the exact string `true` enables it, so a value someone set to `false`
# cannot switch it on by being a non-empty string.
#
# Set on ONE Netlify project (`crewchief-demo`), not two. Read at build time for
# static routes, so changing it needs a redeploy rather than a restart.
CREWCHIEF_DEMO_SITE=

# Which of the two deployments this is.
#
# ⚠ **Unset means "the product", deliberately.** `lib/site-role.ts` carries the
# argument in full: the two failure modes are not symmetrical. A demo that
# accidentally presents as the product is a portfolio piece with slightly wrong
# copy; the product accidentally presenting as a demo is the App Store hostname
# telling a reviewer this is a showcase.
#
# Set to `true` on `crewchief-demo-live` only. Never on `effulgent-blancmange`.
#
# It gates the share card, and as of 24 Aug the pre-launch "iPhone app coming
# soon" line (LEG-10) — which is honest on the demo and reads as a premature
# submission on the page App Review opens.
NEXT_PUBLIC_SITE_ROLE=

# ── The feature gate ─────────────────────────────────────────────────────────
#
# Whether the three paid features — the advisor, invoice scanning and the
# vehicle dossier — are actually withheld from accounts without a subscription.
#
# ⚠ This is NOT a rollout flag and must not be used as one. It encodes a single
# rule, argued in full in `packages/core/src/paid-features.ts`:
#
#     A feature may only be gated behind a purchase the app can actually make.
#
# E8 is unfinished as of 24 Aug: `PaywallScreen` is mounted by no navigator and
# no StoreKit library is installed, so there is nothing to buy. Turning this on
# before that changes takes three features away from every existing account and
# offers them no way back.
#
# ⚠ Only the exact string `true` enables it — not `1`, not `yes`, not `TRUE`. A
# gate that switches on for a typo is a gate that switches on by accident.
#
# ⚠ Turning it on is a product launch, not a config change. Its preconditions
# are a purchasable product in App Store Connect, a reachable paywall, and a
# tested Restore on a second device. Unset means off.
PAID_FEATURES_ENFORCED=

# ── Not set by hand ──────────────────────────────────────────────────────────
#
# `next.config.js` inlines this from `package.json` at build time and
# `/api/version` reports it. It is listed here because `env-parity.test.ts`
# requires every variable the code reads to be documented, and "documented"
# includes saying when the answer is "nothing to do".
#
# ⚠ Setting it would override the file and let the deployed build report a
# version the repository does not have. Leave it alone.
NEXT_PUBLIC_APP_VERSION=
